{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.mjs",
				"scripts/tests/*.test.mjs",
				"tools/schema-generator/tests/*.test.mjs",
				"tools/conformance/tests/*.test.mjs",
				"tools/shared/tests/*.test.mjs"
			],
			"project": [
				"scripts/**/*.mjs",
				"tools/schema-generator/**/*.mjs",
				"tools/conformance/**/*.mjs",
				"tools/shared/**/*.mjs"
			]
		},
		"packages/*": {
			"entry": ["tests/**/*.test.mjs"],
			"project": ["src/**/*.ts"]
		},
		"packages/*/*": {
			"entry": ["tests/**/*.test.mjs"],
			"project": ["src/**/*.ts"]
		}
	}
}
