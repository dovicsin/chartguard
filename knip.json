{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.mjs",
				"scripts/tests/**/*.test.mjs",
				"tools/schema-generator/tests/**/*.test.mjs",
				"tools/conformance/tests/**/*.test.mjs",
				"tools/shared/tests/**/*.test.mjs",
				"tools/api/*.mjs",
				"tools/api/tests/**/*.test.mjs",
				"tools/docs/*.mjs",
				"tools/docs/tests/**/*.test.mjs",
				"tools/fuzz/tests/**/*.test.mjs",
				"tools/benchmarks/lib/probes.mjs",
				"tools/benchmarks/tests/**/*.test.mjs",
				"action/run.mjs",
				"action/tests/**/*.test.mjs"
			],
			"project": [
				"scripts/**/*.mjs",
				"tools/schema-generator/**/*.mjs",
				"tools/conformance/**/*.mjs",
				"tools/shared/**/*.mjs",
				"tools/api/**/*.mjs",
				"tools/docs/**/*.mjs",
				"action/**/*.mjs",
				"tools/fuzz/**/*.mjs",
				"tools/benchmarks/**/*.mjs"
			]
		},
		"packages/schema-generator": {
			"entry": ["tests/**/*.test.mjs"],
			"project": ["lib/**/*.mjs"]
		},
		"packages/*": {
			"entry": ["tests/**/*.test.mjs"],
			"project": ["src/**/*.ts"]
		},
		"apps/playground": {
			"entry": ["src/main.ts", "src/frame.ts", "scripts/*.mjs", "tests/**/*.test.mjs"],
			"project": ["src/**/*.ts", "scripts/*.mjs"]
		},
		"apps/reference": {
			"entry": ["static/search.js", "tests/**/*.test.mjs"],
			"project": ["scripts/*.mjs", "static/*.js"]
		},
		"packages/integrations/*-runtime": {
			"entry": ["tests/**/*.test.mjs", "src/sources.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/integrations/vscode": {
			"entry": ["src/server.ts", "scripts/*.mjs", "tests/**/*.test.mjs", "tests/vscode/*.cjs"],
			"project": ["src/**/*.ts", "scripts/*.mjs"]
		},
		"packages/*/*": {
			"entry": ["tests/**/*.test.mjs"],
			"project": ["src/**/*.ts"]
		}
	}
}
