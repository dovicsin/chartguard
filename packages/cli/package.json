{
	"name": "@chartguard/cli",
	"version": "0.1.1",
	"description": "Single-library explicit CLI for chart checks",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dovicsin/chartguard.git",
		"directory": "packages/cli"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"bin/",
		"dist/",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@chartguard/core": "0.1.1",
		"@chartguard/config-chartjs": "0.1.1",
		"@chartguard/config-echarts": "0.1.1",
		"@chartguard/config-highcharts": "0.1.1",
		"@chartguard/quality-core": "0.1.1",
		"@chartguard/quality-chartjs": "0.1.1",
		"@chartguard/quality-echarts": "0.1.1",
		"@chartguard/quality-highcharts": "0.1.1",
		"@chartguard/analysis-typescript": "0.1.1",
		"@chartguard/schema-generator": "0.1.1"
	},
	"bin": {
		"chartguard": "./bin/chartguard.mjs"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
