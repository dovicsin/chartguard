{
	"name": "@chartguard/eslint-plugin",
	"version": "0.1.1",
	"description": "ESLint 9 plugin: Chart.js, ECharts and Highcharts configs checked in JavaScript and TypeScript source, with fixes for renames and suggested quality edits",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dovicsin/chartguard.git",
		"directory": "packages/integrations/eslint"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"dist/",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@chartguard/source-checks": "0.1.1"
	},
	"peerDependencies": {
		"eslint": "^9.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
