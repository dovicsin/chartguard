{
	"name": "@chartguard/eslint-plugin",
	"version": "0.1.0",
	"private": true,
	"description": "ESLint 9 plugin: chart configs handed to Chart.js, ECharts or Highcharts, checked in source (partial, CG-06-03)",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dovicsin/chartguard.git",
		"directory": "packages/integrations/eslint"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist/",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@chartguard/core": "0.1.0",
		"@chartguard/analysis-typescript": "0.1.0",
		"@chartguard/config-chartjs": "0.1.0",
		"@chartguard/config-echarts": "0.1.0",
		"@chartguard/config-highcharts": "0.1.0"
	},
	"peerDependencies": {
		"eslint": "^9.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
