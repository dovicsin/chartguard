{
	"name": "@chartguard/language-server",
	"version": "0.1.1",
	"description": "Language server (LSP over stdio) with ChartGuard findings and verified edits for chart configs in JavaScript and TypeScript",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dovicsin/chartguard.git",
		"directory": "packages/integrations/language-server"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"bin/",
		"dist/",
		"README.md"
	],
	"bin": {
		"chartguard-language-server": "./bin/chartguard-language-server.mjs"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@chartguard/source-checks": "0.1.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
