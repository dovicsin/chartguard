{
	"name": "@chartguard/analysis-typescript",
	"version": "0.1.0",
	"description": "Safe, bounded TypeScript compiler AST expression reader",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"engines": {
		"node": ">=20.11"
	},
	"files": [
		"dist/",
