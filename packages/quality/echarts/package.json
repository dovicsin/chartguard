{
	"name": "@chartguard/quality-echarts",
	"version": "0.1.1",
	"description": "Apache ECharts adapter for the ChartGuard quality rules: the chart as ECharts draws it, reviewed for misleading or inaccessible patterns",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dovicsin/chartguard.git",
		"directory": "packages/quality/echarts"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"dist/",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@chartguard/core": "0.1.1",
		"@chartguard/quality-core": "0.1.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
