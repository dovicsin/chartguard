{
	"name": "chartguard-monorepo",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Modular chart configuration validation and visualization quality toolkit",
	"engines": {
		"node": ">=20.19",
		"npm": ">=11"
	},
	"packageManager": "npm@11.6.2",
	"workspaces": [
		"packages/core",
		"packages/config/*",
		"packages/quality/*",
		"packages/analysis/*",
		"packages/integrations/*",
		"packages/cli",
		"apps/playground"
	],
	"scripts": {
		"prepare": "husky",
		"build": "node scripts/build.mjs",
		"boundaries": "node scripts/check-boundaries.mjs",
		"schema:generate": "node tools/schema-generator/generate.mjs write",
		"schema:check": "node tools/schema-generator/generate.mjs check",
		"schema:diff": "node tools/schema-generator/diff.mjs",
		"conformance:import": "node tools/conformance/corpus/import.mjs",
		"playground": "node apps/playground/scripts/serve.mjs",
		"typecheck": "tsc -b tsconfig.json",
		"test": "node scripts/test.mjs",
		"test:coverage": "c8 node scripts/test.mjs",
		"lint": "eslint . --max-warnings=0",
		"fix-lint": "eslint . --fix --max-warnings=0",
		"format": "prettier --check .",
		"fix-format": "prettier --write .",
		"knip": "knip",
		"check": "npm run build && npm run boundaries && npm run schema:check && npm run lint && npm run format && npm run knip && npm run test:coverage",
		"precommit": "npm run check",
		"prepush": "npm run build && concurrently --kill-others-on-fail --names boundaries,schema,format,lint,knip,test \"npm run boundaries\" \"npm run schema:check\" \"npm run format\" \"npm run lint\" \"npm run knip\" \"npm run test:coverage\"",
		"demo": "node packages/cli/bin/chartguard.mjs validate --library chartjs --file examples/chartjs-invalid.json",
		"demo:quality": "node packages/cli/bin/chartguard.mjs quality --library chartjs --file examples/chartjs-quality.json",
		"demo:source": "node packages/cli/bin/chartguard.mjs analyze --library chartjs --file examples/chartjs-source.ts"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"c8": "^10.1.3",
		"chart.js": "4.5.1",
		"concurrently": "^9.2.5",
		"echarts": "6.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^17.13.0",
		"highcharts": "13.1.1",
		"husky": "^9.1.7",
		"knip": "^6.41.0",
		"prettier": "^3.9.10",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.2"
	},
	"license": "MIT"
}
