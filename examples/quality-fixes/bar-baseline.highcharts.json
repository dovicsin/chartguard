{
	"rule": "bar-baseline",
	"library": "highcharts",
	"title": "Columns growing from a threshold of 60",
	"before": {
		"chart": {
			"type": "column"
		},
		"title": {
			"text": "Quarterly sales"
		},
		"palette": {
			"colors": ["#1f77b4", "#d62728", "#2ca02c"]
		},
		"xAxis": {
			"categories": ["Q1", "Q2", "Q3"]
		},
		"yAxis": {
			"title": {
				"text": "Units"
			}
		},
		"series": [
			{
				"name": "Sales",
				"data": [62, 65, 71]
			}
		],
		"plotOptions": {
			"column": {
				"threshold": 60
			}
		}
	},
	"findings": [
		{
			"code": "VIS_BAR_BASELINE",
			"path": "$.plotOptions.column.threshold",
			"fix": {
				"kind": "set-option",
				"path": "$.plotOptions.column.threshold",
				"from": 60,
				"value": 0,
				"effect": "The bars grow from zero again, so their lengths are proportional to their values."
			}
		}
	],
	"after": {
		"chart": {
			"type": "column"
		},
		"title": {
			"text": "Quarterly sales"
		},
		"palette": {
			"colors": ["#1f77b4", "#d62728", "#2ca02c"]
		},
		"xAxis": {
			"categories": ["Q1", "Q2", "Q3"]
		},
		"yAxis": {
			"title": {
				"text": "Units"
			}
		},
		"series": [
			{
				"name": "Sales",
				"data": [62, 65, 71]
			}
		],
		"plotOptions": {
			"column": {
				"threshold": 0
			}
		}
	}
}
