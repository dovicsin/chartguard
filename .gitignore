# Allowlist: everything is ignored unless it is source, a test, a fixture or
# the tooling that builds and guards them. Add new entries deliberately.
*
!*/

# Root tooling
!/.gitignore
!/.editorconfig
!/.npmrc
!/.prettierignore
!/.c8rc.json
!/.husky/pre-commit
!/.husky/pre-push
!/.github/workflows/*.yml
!/package.json
!/README.md
!/LICENSE
!/package-lock.json
!/tsconfig.json
!/tsconfig.base.json
!/eslint.config.js
!/prettier.config.js
!/knip.json
!/scripts/**/*.mjs
!/scripts/labels.json
!/tools/schema-generator/**/*.mjs
!/tools/conformance/**/*.mjs
!/tools/conformance/corpus/*.json
!/tools/shared/**/*.mjs
!/tools/api/**/*.mjs
!/tools/api/surfaces/*.api.md
!/tools/docs/**/*.mjs
!/.changeset/config.json

# Public governance (CG-00-05); issue and PR templates and the contributor guide in docs/ stay local
!/CONTRIBUTING.md
!/SECURITY.md
!/.github/CODEOWNERS

# Fixtures
!/examples/*.json
!/examples/*.ts
# Before/after examples of the quality fixes (CG-05-06)
!/examples/quality-fixes/*.json
# The M3 gate sample app (code only; its README stays local)
!/examples/sample-app/tsconfig.json
!/examples/sample-app/src/**/*.ts
!/examples/sample-app/src/**/*.tsx
!/examples/sample-app/src/**/*.js
# The M4 gate runtime sample apps (code only; their README stays local)
!/examples/runtime-apps/tsconfig.json
!/examples/runtime-apps/src/*.ts

# Packages
!/packages/**/package.json
!/packages/**/README.md
!/packages/**/NOTICE
!/packages/**/tsconfig.json
!/packages/**/src/**/*.ts
!/packages/**/src/generated/*.json
!/packages/**/tests/**/*.mjs
!/packages/cli/bin/*.mjs
# The schema generator is JavaScript with JSDoc (types are emitted from it); its pin file ships with it.
!/packages/schema-generator/index.mjs
!/packages/schema-generator/lib/*.mjs
!/packages/schema-generator/upstream-sources.json

# Apps (code only; their README files stay local)
!/apps/playground/package.json
!/apps/playground/tsconfig.json
!/apps/playground/src/**/*.ts
!/apps/playground/static/*
!/apps/playground/scripts/*.mjs
!/apps/playground/tests/*.mjs

# Never tracked, even below an allowlisted path
node_modules/
# Highcharts-derived schemas may not be redistributed (CG-01-05); they are generated locally.
/packages/config/highcharts/src/generated/
dist/
coverage/
.husky/_/
*.d.ts
*.map
*.tsbuildinfo
*.log
.env*
