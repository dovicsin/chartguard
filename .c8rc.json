{
	"all": true,
	"src": ["packages", "apps", "scripts", "tools"],
	"include": [
		"packages/**/dist/**/*.js",
		"scripts/boundaries/**/*.mjs",
		"packages/schema-generator/lib/**/*.mjs",
		"tools/schema-generator/lib/**/*.mjs",
		"tools/api/**/*.mjs",
		"tools/docs/**/*.mjs",
		"tools/conformance/lib/**/*.mjs",
		"tools/shared/**/*.mjs",
		"tools/fuzz/lib/*.mjs",
		"tools/benchmarks/**/*.mjs",
		"apps/playground/dist/{model,examples,selftest}.js",
		"apps/reference/scripts/*.mjs",
		"action/*.mjs"
	],
	"exclude": [
		"**/node_modules/**",
		"**/tests/**",
		"packages/core/dist/diagnostic.js",
		"packages/quality/core/dist/chart.js"
	],
	"reporter": ["text", "html"],
	"check-coverage": true,
	"lines": 95,
	"functions": 90,
	"branches": 90,
	"statements": 95
}
